# Sanity (create a free project at https://www.sanity.io)
# Used by the app, the build-time prerenderer and the sitemap generator.
# Copy this file to .env.local and fill in your real values.
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Site URL used for canonical tags, sitemap and OG URLs (optional, defaults to https://samisher.com)
SITE_URL=https://samisher.com

# --- Automatic search engine indexing (optional) ---
# IndexNow: instant submission to Bing/Yandex/Seznam. Key file must exist at public/<key>.txt
INDEXNOW_KEY=your-indexnow-key

# Google Indexing API ("Request Indexing" as an API). Create a service account
# with the Indexing API enabled, add its email as an OWNER in Google Search Console,
# then set either the two vars below or GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
